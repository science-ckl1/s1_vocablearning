        // ================= MODE 1: LAB SCRAMBLE LOGIC =================
        function startScrambleMode() {
            gameState.currentMode = 'scramble';
            gameState.wordIndex = 0;
            gameState.score = 0;
            gameState.streak = 0;
            showScreen('scrambleScreen');
            loadScrambleWord();
        }

        function loadScrambleWord() {
            if (gameState.wordIndex >= VOCABULARY.length) {
                endGameRound();
                return;
            }

            const currentObj = VOCABULARY[gameState.wordIndex];
            const word = currentObj.word.toUpperCase();
            gameState.selectedLetters = [];
            gameState.scrambleHintUsed = false;

            // Update Header Stats
            document.getElementById('scrambleProgressText').innerText = `${gameState.wordIndex + 1} / ${VOCABULARY.length}`;
            document.getElementById('scrambleScoreText').innerText = gameState.score;
            document.getElementById('scrambleStreakText').innerText = `${gameState.streak}🔥`;
            document.getElementById('scrambleDefinition').innerText = `"${currentObj.clue}"`;

            // Speak word audio once on load
            speakWord(currentObj.word);

            // Shuffle letters
            let letters = word.split('');
            // Ensure shuffled version isn't identical to target word
            do {
                letters.sort(() => Math.random() - 0.5);
            } while (letters.join('') === word && word.length > 2);

            gameState.shuffledLetters = letters.map((char, id) => ({ id, char, used: false }));

            renderScrambleTiles();
        }

        function renderScrambleTiles() {
            const currentObj = VOCABULARY[gameState.wordIndex];
            const targetLength = currentObj.word.length;

            // Render Slots
            const targetSlots = document.getElementById('targetSlots');
            targetSlots.innerHTML = '';
            
            for (let i = 0; i < targetLength; i++) {
                const filled = gameState.selectedLetters[i];
                const slotBtn = document.createElement('button');
                slotBtn.className = `w-11 h-12 sm:w-12 sm:h-14 rounded-xl border-2 font-outfit font-extrabold text-xl sm:text-2xl flex items-center justify-center transition-all ${
                    filled 
                    ? 'bg-cyan-500/20 border-cyan-400 text-cyan-200 shadow-md shadow-cyan-500/20' 
                    : 'bg-slate-900/60 border-slate-700/80 text-slate-600'
                }`;
                slotBtn.innerText = filled ? filled.char : '';
                if (filled) {
                    slotBtn.onclick = () => removeSelectedLetter(i);
                }
                targetSlots.appendChild(slotBtn);
            }

            // Render Letter Pool
            const pool = document.getElementById('scrambledLettersPool');
            pool.innerHTML = '';

            gameState.shuffledLetters.forEach(item => {
                const letterBtn = document.createElement('button');
                letterBtn.disabled = item.used;
                letterBtn.className = `tile-btn w-11 h-12 sm:w-12 sm:h-14 rounded-xl font-outfit font-extrabold text-lg sm:text-xl border-2 transition-all ${
                    item.used 
                    ? 'opacity-20 bg-slate-900 border-slate-800 text-slate-600 cursor-not-allowed' 
                    : 'bg-slate-800 hover:bg-slate-700 border-slate-600 hover:border-cyan-400 text-white shadow-lg'
                }`;
                letterBtn.innerText = item.char;
                letterBtn.onclick = () => selectScrambleLetter(item);
                pool.appendChild(letterBtn);
            });
        }

        function selectScrambleLetter(item) {
            if (item.used) return;
            sfx.click();
            item.used = true;
            gameState.selectedLetters.push(item);
            renderScrambleTiles();
        }

        function removeSelectedLetter(index) {
            sfx.click();
            const removed = gameState.selectedLetters.splice(index, 1)[0];
            if (removed) {
                const poolItem = gameState.shuffledLetters.find(x => x.id === removed.id);
                if (poolItem) poolItem.used = false;
            }
            renderScrambleTiles();
        }

        function resetScrambleAnswer() {
            sfx.click();
            gameState.selectedLetters = [];
            gameState.shuffledLetters.forEach(item => item.used = false);
            renderScrambleTiles();
        }

        function useScrambleHint() {
            if (gameState.scrambleHintUsed) return;
            const targetWord = VOCABULARY[gameState.wordIndex].word.toUpperCase();
            
            // Find first missing or wrong letter
            let targetIdx = gameState.selectedLetters.length;
            if (targetIdx >= targetWord.length) return;

            sfx.click();
            gameState.score = Math.max(0, gameState.score - 10);
            gameState.scrambleHintUsed = true;

            const neededChar = targetWord[targetIdx];
            const unusedItem = gameState.shuffledLetters.find(x => !x.used && x.char === neededChar);
            if (unusedItem) {
                selectScrambleLetter(unusedItem);
            }
        }

        function playCurrentWordAudio() {
            const currentObj = VOCABULARY[gameState.wordIndex];
            if (currentObj) speakWord(currentObj.word);
        }

        function checkScrambleAnswer() {
            const currentObj = VOCABULARY[gameState.wordIndex];
            const targetWord = currentObj.word.toUpperCase();
            const userAttempt = gameState.selectedLetters.map(x => x.char).join('');

            if (userAttempt === targetWord) {
                // Correct!
                sfx.correct();
                gameState.score += 100 + (gameState.streak * 20);
                gameState.streak++;
                if (gameState.streak > gameState.bestStreak) gameState.bestStreak = gameState.streak;

                if (!gameState.masteredWords.includes(currentObj.word)) {
                    gameState.masteredWords.push(currentObj.word);
                }

                if (gameState.streak >= 5) unlockBadge('streak_5');

                gameState.wordIndex++;
                loadScrambleWord();
            } else {
                // Wrong
                sfx.wrong();
                gameState.streak = 0;
                const slotContainer = document.getElementById('targetSlots');
                slotContainer.classList.add('animate-shake');
                setTimeout(() => slotContainer.classList.remove('animate-shake'), 400);
            }
        }

        // ================= MODE 2: LASER TARGET BLAST LOGIC =================
        let meteorInterval = null;

        function startMeteorMode() {
            gameState.currentMode = 'meteor';
            gameState.wordIndex = 0;
            gameState.score = 0;
            gameState.lives = 3;
            gameState.streak = 0;
            showScreen('meteorScreen');
            loadMeteorTarget();
        }

        function loadMeteorTarget() {
            if (gameState.wordIndex >= VOCABULARY.length || gameState.lives <= 0) {
                endGameRound();
                return;
            }

            const currentObj = VOCABULARY[gameState.wordIndex];
            const word = currentObj.word.toUpperCase();
            
            // Choose a missing letter index
            const missingIdx = Math.floor(Math.random() * word.length);
            const missingChar = word[missingIdx];

            // Render Word with blank underscore
            let displayChars = word.split('');
            displayChars[missingIdx] = '<span class="text-purple-400 border-b-4 border-purple-400 px-2 animate-pulse">_</span>';
            
            document.getElementById('meteorWordDisplay').innerHTML = displayChars.join(' ');
            document.getElementById('meteorClueText').innerText = `"${currentObj.clue}"`;
            document.getElementById('meteorScoreText').innerText = gameState.score;
            
            // Render Lives
            const livesContainer = document.getElementById('meteorLivesContainer');
            livesContainer.innerHTML = '';
            for (let i = 0; i < 3; i++) {
                const icon = document.createElement('i');
                icon.className = `fa-solid fa-shield text-sm ${i < gameState.lives ? 'text-cyan-400' : 'text-slate-700'}`;
                livesContainer.appendChild(icon);
            }

            // Speak audio hint
            speakWord(currentObj.word);

            // Generate Key Options (including correct letter + distractor options)
            let options = [missingChar];
            const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            while (options.length < 6) {
                const randomChar = alphabet[Math.floor(Math.random() * alphabet.length)];
                if (!options.includes(randomChar)) options.push(randomChar);
            }
            options.sort(() => Math.random() - 0.5);

            const keyOptionsDiv = document.getElementById('meteorKeyOptions');
            keyOptionsDiv.innerHTML = '';

            options.forEach(char => {
                const keyBtn = document.createElement('button');
                keyBtn.className = "py-3 rounded-xl bg-slate-800 hover:bg-purple-600/80 border border-slate-700 font-outfit font-extrabold text-lg text-white transition active:scale-95 shadow-md";
                keyBtn.innerText = char;
                keyBtn.onclick = () => testMeteorKey(char, missingChar);
                keyOptionsDiv.appendChild(keyBtn);
            });
        }

        function testMeteorKey(selectedKey, correctKey) {
            sfx.laser();
            if (selectedKey === correctKey) {
                sfx.correct();
                gameState.score += 150;
                gameState.streak++;
                const currentObj = VOCABULARY[gameState.wordIndex];
                if (!gameState.masteredWords.includes(currentObj.word)) {
                    gameState.masteredWords.push(currentObj.word);
                }
                gameState.wordIndex++;
                loadMeteorTarget();
            } else {
                sfx.wrong();
                gameState.lives--;
                gameState.streak = 0;
                
                const box = document.getElementById('meteorTargetBox');
                box.classList.add('animate-shake');
                setTimeout(() => box.classList.remove('animate-shake'), 400);

                if (gameState.lives <= 0) {
                    endGameRound();
                } else {
                    loadMeteorTarget();
                }
            }
        }

        // ================= MODE 3: AUDIO LAB EXAM LOGIC =================
        function startDrillMode() {
            gameState.currentMode = 'drill';
            gameState.wordIndex = 0;
            gameState.score = 0;
            showScreen('drillScreen');
            loadDrillWord();
        }

        function loadDrillWord() {
            if (gameState.wordIndex >= VOCABULARY.length) {
                endGameRound();
                return;
            }

            const currentObj = VOCABULARY[gameState.wordIndex];
            document.getElementById('drillProgressText').innerText = `${gameState.wordIndex + 1} / ${VOCABULARY.length}`;
            document.getElementById('drillScoreText').innerText = gameState.score;
            document.getElementById('drillClue').innerText = `"${currentObj.clue}"`;
            
            const input = document.getElementById('drillInput');
            input.value = '';
            input.focus();

            speakWord(currentObj.word);
        }

        function submitDrillAnswer() {
            const currentObj = VOCABULARY[gameState.wordIndex];
            const targetWord = currentObj.word.toLowerCase().trim();
            const inputVal = document.getElementById('drillInput').value.toLowerCase().trim();

            if (inputVal === targetWord) {
                sfx.correct();
                gameState.score += 120;
                if (!gameState.masteredWords.includes(currentObj.word)) {
                    gameState.masteredWords.push(currentObj.word);
                }
                gameState.wordIndex++;
                loadDrillWord();
            } else {
                sfx.wrong();
                const input = document.getElementById('drillInput');
                input.classList.add('animate-shake', 'border-red-500');
                setTimeout(() => input.classList.remove('animate-shake', 'border-red-500'), 500);
            }
        }

        // Global Physical Keyboard Listener
        document.addEventListener('keydown', (e) => {
            const key = e.key.toUpperCase();
            
            // Mode 1: Scramble key pressing
            if (gameState.currentMode === 'scramble' && !document.getElementById('scrambleScreen').classList.contains('hidden')) {
                if (key === 'ENTER') {
                    checkScrambleAnswer();
                } else if (key === 'BACKSPACE') {
                    if (gameState.selectedLetters.length > 0) {
                        removeSelectedLetter(gameState.selectedLetters.length - 1);
                    }
                } else if (/^[A-Z]$/.test(key)) {
                    const unusedItem = gameState.shuffledLetters.find(x => !x.used && x.char === key);
                    if (unusedItem) selectScrambleLetter(unusedItem);
                }
            }

            // Mode 3: Drill Enter key
            if (gameState.currentMode === 'drill' && !document.getElementById('drillScreen').classList.contains('hidden')) {
                if (e.key === 'Enter') submitDrillAnswer();
            }
        });

        // ================= GAME OVER / RESULTS SYSTEM =================
        function endGameRound() {
            sfx.victory();
            unlockBadge('first_win');

            if (gameState.masteredWords.length === VOCABULARY.length) {
                unlockBadge('master_all');
            }

            const starsEarned = gameState.score > 800 ? 3 : (gameState.score > 400 ? 2 : 1);
            const xpGained = Math.round(gameState.score * 1.5);

            gameState.totalStars += starsEarned;
            gameState.totalXP += xpGained;

            updateGlobalHeader();

            // Populate Modal
            document.getElementById('modalScore').innerText = `${gameState.score} Pts`;
            document.getElementById('modalXP').innerText = `+${xpGained} XP`;
            document.getElementById('modalAccuracy').innerText = `${Math.min(100, Math.round((gameState.score / 1000) * 100))}%`;
            document.getElementById('modalWords').innerText = `${gameState.wordIndex} / ${VOCABULARY.length}`;

            document.getElementById('resultModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('resultModal').classList.add('hidden');
        }

        function retryCurrentMode() {
            closeModal();
            if (gameState.currentMode === 'scramble') startScrambleMode();
            else if (gameState.currentMode === 'meteor') startMeteorMode();
            else if (gameState.currentMode === 'drill') startDrillMode();
        }

        function exitToMenu() {
            sfx.click();
            showScreen('menuScreen');
        }

        // Badges Management
        function unlockBadge(badgeId) {
            if (!gameState.unlockedBadges.includes(badgeId)) {
                gameState.unlockedBadges.push(badgeId);
                updateGlobalHeader();
            }
        }

        function renderBadges() {
            const grid = document.getElementById('badgeGrid');
            grid.innerHTML = BADGES.map(badge => {
                const unlocked = gameState.unlockedBadges.includes(badge.id);
                return `
                    <div class="glass-panel p-5 rounded-2xl flex items-center space-x-4 ${unlocked ? 'border-amber-500/40 bg-slate-800/80' : 'opacity-50 border-slate-800'} transition">
                        <div class="w-12 h-12 rounded-xl ${unlocked ? 'bg-amber-500/20' : 'bg-slate-800'} flex items-center justify-center text-2xl ${badge.color}">
                            <i class="fa-solid ${badge.icon}"></i>
                        </div>
                        <div>
                            <h4 class="font-outfit font-bold text-white text-base">${badge.name}</h4>
                            <p class="text-xs text-slate-400 mt-0.5">${badge.desc}</p>
                            <span class="inline-block mt-2 text-[10px] font-bold uppercase tracking-wider ${unlocked ? 'text-amber-400' : 'text-slate-600'}">
                                ${unlocked ? 'Unlocked ✓' : 'Locked'}
                            </span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Initialize menu on startup
        updateGlobalHeader();
    </script>
</body>
</html>
