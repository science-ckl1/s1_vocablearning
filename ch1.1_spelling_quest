<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Science Spell Quest - Interactive Spelling Game</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Fredoka', 'Outfit', sans-serif;
            background-color: #0b0f19;
            color: #f3f4f6;
            overflow-x: hidden;
            user-select: none;
        }

        .font-outfit {
            font-family: 'Outfit', sans-serif;
        }

        /* Glow effects */
        .glow-cyan {
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);
        }
        .glow-purple {
            box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
        }
        .glow-green {
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.4);
        }
        .text-glow {
            text-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
        }

        /* Tile Animations */
        .tile-btn {
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .tile-btn:active {
            transform: scale(0.92);
        }

        @keyframes pulse-subtle {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .animate-pulse-subtle {
            animation: pulse-subtle 2s infinite ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: float 3s ease-in-out infinite;
        }

        /* Glassmorphism */
        .glass-panel {
            background: rgba(17, 24, 39, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }
    </style>
</head>
<body class="h-full flex flex-col justify-between relative text-gray-100">

    <!-- Background Canvas for Interactive Science Particles -->
    <canvas id="bgCanvas"></canvas>

    <!-- Top Navigation / Stats Header -->
    <header class="relative z-10 w-full px-4 py-3 glass-panel border-b border-slate-800">
        <div class="max-w-5xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="showScreen('menuScreen')">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-lg shadow-cyan-500/30">
                    <i class="fa-solid font-bold fa-flask-vial text-xl animate-float"></i>
                </div>
                <div>
                    <h1 class="font-outfit font-extrabold text-xl tracking-wide bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400 bg-clip-text text-transparent">
                        SPELL LAB
                    </h1>
                    <p class="text-xs text-slate-400 font-medium">Science Vocabulary Edition</p>
                </div>
            </div>

            <!-- Global Player Score & XP Bar -->
            <div class="flex items-center space-x-4">
                <div class="hidden sm:flex items-center bg-slate-900/80 px-3 py-1.5 rounded-full border border-slate-700/60">
                    <i class="fa-solid fa-star text-amber-400 mr-2 text-sm"></i>
                    <span id="globalStars" class="text-sm font-bold text-amber-300">0</span>
                    <span class="text-xs text-slate-500 mx-1.5">|</span>
                    <i class="fa-solid fa-bolt text-cyan-400 mr-1.5 text-sm"></i>
                    <span id="globalXP" class="text-sm font-bold text-cyan-300">0 XP</span>
                </div>

                <!-- Audio Sound FX & Speech Toggle -->
                <button id="soundToggleBtn" onclick="toggleSound()" class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 flex items-center justify-center text-slate-300 transition-all hover:text-white" title="Toggle Sound">
                    <i id="soundIcon" class="fa-solid fa-volume-high"></i>
                </button>

                <button onclick="showScreen('badgeScreen')" class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 flex items-center justify-center text-amber-400 hover:text-amber-300 transition-all" title="View Badges">
                    <i class="fa-solid fa-trophy"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Game Container -->
    <main class="relative z-10 flex-grow flex items-center justify-center p-4">
        <div class="w-full max-w-4xl">

            <!-- ================= MAIN MENU SCREEN ================= -->
            <div id="menuScreen" class="space-y-6 text-center py-4">
                <div class="space-y-3">
                    <span class="inline-block px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold uppercase tracking-wider">
                        Master Your Science Spelling
                    </span>
                    <h2 class="text-4xl sm:text-5xl font-outfit font-extrabold text-white text-glow">
                        Ready to Become a <span class="bg-gradient-to-r from-cyan-400 to-indigo-400 bg-clip-text text-transparent">Spell Scientist?</span>
                    </h2>
                    <p class="text-slate-300 max-w-xl mx-auto text-sm sm:text-base">
                        Test your memory, unscramble complex words, and blast spelling targets to master key scientific vocabulary!
                    </p>
                </div>

                <!-- Vocabulary Quick Stats Overview -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl mx-auto pt-2">
                    <div class="glass-panel p-3 rounded-2xl text-center">
                        <i class="fa-solid fa-book-bookmark text-cyan-400 text-lg mb-1"></i>
                        <p class="text-xs text-slate-400">Target Words</p>
                        <p id="totalTermsText" class="text-lg font-bold text-white">10 Terms</p>
                    </div>
                    <div class="glass-panel p-3 rounded-2xl text-center">
                        <i class="fa-solid fa-award text-amber-400 text-lg mb-1"></i>
                        <p class="text-xs text-slate-400">Mastery Level</p>
                        <p id="masteryPercent" class="text-lg font-bold text-white">0%</p>
                    </div>
                    <div class="glass-panel p-3 rounded-2xl text-center">
                        <i class="fa-solid fa-fire text-orange-400 text-lg mb-1"></i>
                        <p class="text-xs text-slate-400">Best Streak</p>
                        <p id="bestStreakText" class="text-lg font-bold text-white">0</p>
                    </div>
                    <div class="glass-panel p-3 rounded-2xl text-center">
                        <i class="fa-solid fa-medal text-purple-400 text-lg mb-1"></i>
                        <p class="text-xs text-slate-400">Badges</p>
                        <p id="badgeCountText" class="text-lg font-bold text-white">0 / 5</p>
                    </div>
                </div>

                <!-- Game Mode Selection Cards -->
                <div class="grid sm:grid-cols-3 gap-4 pt-4 text-left">
                    
                    <!-- Mode 1: Lab Scramble -->
                    <div onclick="startScrambleMode()" class="glass-panel p-5 rounded-2xl cursor-pointer hover:border-cyan-500/60 hover:bg-slate-800/80 transition-all duration-300 transform hover:-translate-y-1 group flex flex-col justify-between">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-vial-circle-check"></i>
                            </div>
                            <h3 class="font-outfit font-bold text-lg text-white group-hover:text-cyan-300 transition-colors">
                                Lab Scramble
                            </h3>
                            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
                                Unscramble chemical element letter bubbles to construct the correct scientific terms.
                            </p>
                        </div>
                        <div class="mt-6 flex items-center justify-between text-xs text-cyan-400 font-semibold">
                            <span>Play Scramble</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Mode 2: Target Blast -->
                    <div onclick="startMeteorMode()" class="glass-panel p-5 rounded-2xl cursor-pointer hover:border-purple-500/60 hover:bg-slate-800/80 transition-all duration-300 transform hover:-translate-y-1 group flex flex-col justify-between">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-purple-500/20 text-purple-400 border border-purple-500/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-crosshair"></i>
                            </div>
                            <h3 class="font-outfit font-bold text-lg text-white group-hover:text-purple-300 transition-colors">
                                Laser Target Blast
                            </h3>
                            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
                                Fill in missing letters as word targets float downwards before they crash into the lab shield!
                            </p>
                        </div>
                        <div class="mt-6 flex items-center justify-between text-xs text-purple-400 font-semibold">
                            <span>Play Arcade</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                    <!-- Mode 3: Audio Drill -->
                    <div onclick="startDrillMode()" class="glass-panel p-5 rounded-2xl cursor-pointer hover:border-emerald-500/60 hover:bg-slate-800/80 transition-all duration-300 transform hover:-translate-y-1 group flex flex-col justify-between">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-headphones"></i>
                            </div>
                            <h3 class="font-outfit font-bold text-lg text-white group-hover:text-emerald-300 transition-colors">
                                Audio Lab Exam
                            </h3>
                            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
                                Listen to voice pronunciation and clue hints, then spell the term accurately against time.
                            </p>
                        </div>
                        <div class="mt-6 flex items-center justify-between text-xs text-emerald-400 font-semibold">
                            <span>Start Exam</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>

                </div>

                <!-- Vocabulary Study Hub Button -->
                <div class="pt-2">
                    <button onclick="showScreen('studyScreen')" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-gradient-to-r from-slate-800 to-slate-900 border border-slate-700 hover:border-slate-500 text-slate-200 hover:text-white font-bold text-sm transition-all shadow-lg flex items-center justify-center mx-auto space-x-2">
                        <i class="fa-solid fa-atom text-cyan-400 text-lg"></i>
                        <span>Explore Vocabulary Flashcard Deck</span>
                    </button>
                </div>
            </div>

            <!-- ================= VOCABULARY STUDY DECK ================= -->
            <div id="studyScreen" class="hidden space-y-6">
                <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                    <div>
                        <h2 class="text-2xl font-outfit font-extrabold text-white flex items-center gap-2">
                            <i class="fa-solid fa-book-open text-cyan-400"></i>
                            Science Vocabulary Deck
                        </h2>
                        <p class="text-xs text-slate-400">Click any word card to hear audio pronunciation, phonetic guide, and scientific definition.</p>
                    </div>
                    <button onclick="showScreen('menuScreen')" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300 border border-slate-700 transition">
                        <i class="fa-solid fa-house mr-1.5"></i> Menu
                    </button>
                </div>

                <!-- Word Grid -->
                <div id="vocabGrid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Dynamic rendering via JS -->
                </div>
            </div>

            <!-- ================= MODE 1: LAB SCRAMBLE GAME ================= -->
            <div id="scrambleScreen" class="hidden space-y-6">
                <!-- Top Progress Bar -->
                <div class="flex items-center justify-between glass-panel px-4 py-3 rounded-2xl">
                    <button onclick="exitToMenu()" class="text-xs font-semibold text-slate-400 hover:text-white">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Exit
                    </button>
                    
                    <div class="flex items-center space-x-6">
                        <div class="text-center">
                            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Word</p>
                            <p id="scrambleProgressText" class="text-sm font-bold text-cyan-400">1 / 10</p>
                        </div>
                        <div class="text-center">
                            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Score</p>
                            <p id="scrambleScoreText" class="text-sm font-bold text-amber-400">0</p>
                        </div>
                        <div class="text-center">
                            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Streak</p>
                            <p id="scrambleStreakText" class="text-sm font-bold text-purple-400">0🔥</p>
                        </div>
                    </div>
                </div>

                <!-- Active Game Card -->
                <div class="glass-panel p-6 sm:p-8 rounded-3xl text-center space-y-6 relative overflow-hidden">
                    
                    <!-- Audio & Definition Clue -->
                    <div class="space-y-3">
                        <div class="flex items-center justify-center space-x-2">
                            <button onclick="playCurrentWordAudio()" class="px-3.5 py-1.5 rounded-full bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/40 text-cyan-300 text-xs font-semibold flex items-center space-x-2 transition">
                                <i class="fa-solid fa-volume-high text-cyan-400"></i>
                                <span>Listen Pronunciation</span>
                            </button>
                            <button onclick="useScrambleHint()" id="hintBtn" class="px-3.5 py-1.5 rounded-full bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 text-xs font-semibold flex items-center space-x-1.5 transition">
                                <i class="fa-solid fa-lightbulb"></i>
                                <span>Hint (-10 pts)</span>
                            </button>
                        </div>

                        <p id="scrambleDefinition" class="text-slate-300 text-sm max-w-lg mx-auto bg-slate-900/60 p-3 rounded-xl border border-slate-800 italic">
                            <!-- Clue goes here -->
                        </p>
                    </div>

                    <!-- Target Word Slots (Assembled word) -->
                    <div class="flex flex-col items-center space-y-2">
                        <p class="text-xs text-slate-400 uppercase tracking-widest font-semibold">Assemble Word</p>
                        <div id="targetSlots" class="flex flex-wrap items-center justify-center gap-2 min-h-[60px] p-2">
                            <!-- Target tiles will appear here -->
                        </div>
                    </div>

                    <!-- Scrambled Available Letters Pool -->
                    <div class="space-y-2 pt-2 border-t border-slate-800/80">
                        <p class="text-xs text-slate-400">Click letters in order or use physical keyboard</p>
                        <div id="scrambledLettersPool" class="flex flex-wrap items-center justify-center gap-2 max-w-xl mx-auto min-h-[60px]">
                            <!-- Available scrambled letter buttons -->
                        </div>
                    </div>

                    <!-- Control Action Buttons -->
                    <div class="flex items-center justify-center space-x-3 pt-2">
                        <button onclick="resetScrambleAnswer()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold border border-slate-700 transition">
                            <i class="fa-solid fa-rotate-left mr-1"></i> Clear
                        </button>
                        <button onclick="checkScrambleAnswer()" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white text-sm font-bold shadow-lg shadow-cyan-500/25 transition transform active:scale-95">
                            Submit Answer <i class="fa-solid fa-check ml-1.5"></i>
                        </button>
                    </div>

                </div>
            </div>

            <!-- ================= MODE 2: LASER TARGET BLAST ================= -->
            <div id="meteorScreen" class="hidden space-y-6">
                <!-- Arcade Header -->
                <div class="flex items-center justify-between glass-panel px-4 py-3 rounded-2xl">
                    <button onclick="exitToMenu()" class="text-xs font-semibold text-slate-400 hover:text-white">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Exit
                    </button>
                    <div class="flex items-center space-x-6">
                        <div class="text-center">
                            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Score</p>
                            <p id="meteorScoreText" class="text-sm font-bold text-purple-400">0</p>
                        </div>
                        <div class="text-center">
                            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Lab Shield</p>
                            <div class="flex items-center space-x-1" id="meteorLivesContainer">
                                <i class="fa-solid fa-shield text-cyan-400 text-sm"></i>
                                <i class="fa-solid fa-shield text-cyan-400 text-sm"></i>
                                <i class="fa-solid fa-shield text-cyan-400 text-sm"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Laser Target Playfield Canvas Box -->
                <div class="glass-panel rounded-3xl p-6 sm:p-8 relative min-h-[360px] flex flex-col justify-between items-center overflow-hidden border border-purple-500/20">
                    
                    <!-- Floating Target Word Element -->
                    <div id="meteorTargetBox" class="w-full max-w-md bg-slate-900/90 border-2 border-purple-500/60 p-5 rounded-2xl text-center space-y-3 transition-all duration-300 shadow-xl shadow-purple-500/10">
                        <span class="inline-block px-2.5 py-0.5 rounded-full bg-purple-500/20 text-purple-300 text-[10px] font-bold uppercase tracking-wider">
                            Identify Missing Letter
                        </span>
                        
                        <div id="meteorWordDisplay" class="text-3xl sm:text-4xl font-outfit font-extrabold text-white tracking-widest my-2">
                            <!-- e.g. B _ o l o g y -->
                        </div>

                        <p id="meteorClueText" class="text-xs text-slate-300 italic max-w-xs mx-auto">
                            <!-- Definition clue -->
                        </p>
                    </div>

                    <!-- Keyboard Option Keypad -->
                    <div class="w-full max-w-xl space-y-3 mt-6">
                        <p class="text-center text-xs text-slate-400 font-semibold">Select or type the correct letter to blast target:</p>
                        <div id="meteorKeyOptions" class="grid grid-cols-4 sm:grid-cols-6 gap-2">
                            <!-- Dynamic Key Choice buttons -->
                        </div>
                    </div>

                </div>
            </div>

            <!-- ================= MODE 3: AUDIO LAB EXAM ================= -->
            <div id="drillScreen" class="hidden space-y-6">
                <!-- Exam Header -->
                <div class="flex items-center justify-between glass-panel px-4 py-3 rounded-2xl">
                    <button onclick="exitToMenu()" class="text-xs font-semibold text-slate-400 hover:text-white">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Exit
                    </button>
                    <div class="flex items-center space-x-6">
                        <div class="text-center">
                            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Word</p>
                            <p id="drillProgressText" class="text-sm font-bold text-emerald-400">1 / 10</p>
                        </div>
                        <div class="text-center">
                            <p class="text-[10px] text-slate-400 uppercase tracking-wider">Score</p>
                            <p id="drillScoreText" class="text-sm font-bold text-amber-400">0</p>
                        </div>
                    </div>
                </div>

                <!-- Exam Card -->
                <div class="glass-panel p-6 sm:p-10 rounded-3xl text-center space-y-6">
                    
                    <div class="w-20 h-20 mx-auto rounded-full bg-emerald-500/20 border-2 border-emerald-500/50 flex items-center justify-center text-emerald-400 text-3xl shadow-lg shadow-emerald-500/20 cursor-pointer hover:scale-105 transition-transform" onclick="playCurrentWordAudio()">
                        <i class="fa-solid fa-volume-high animate-pulse-subtle"></i>
                    </div>

                    <div>
                        <p class="text-xs text-emerald-400 font-semibold uppercase tracking-wider mb-1">Click Speaker to Listen</p>
                        <p id="drillClue" class="text-slate-300 text-sm max-w-md mx-auto bg-slate-900/60 p-3 rounded-xl border border-slate-800 italic">
                            <!-- Clue -->
                        </p>
                    </div>

                    <!-- Direct Text Box Input -->
                    <div class="max-w-md mx-auto space-y-3">
                        <input type="text" id="drillInput" placeholder="Type full spelling here..." autocomplete="off" spellcheck="false" class="w-full text-center text-xl sm:text-2xl font-outfit font-bold py-3.5 px-4 rounded-2xl bg-slate-900 border-2 border-slate-700 focus:border-emerald-500 focus:outline-none text-white tracking-widest placeholder:text-slate-600 placeholder:text-base transition">
                        
                        <div class="flex space-x-2">
                            <button onclick="playCurrentWordAudio()" class="w-1/3 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold border border-slate-700 transition">
                                <i class="fa-solid fa-repeat mr-1"></i> Repeat Word
                            </button>
                            <button onclick="submitDrillAnswer()" class="w-2/3 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white text-sm font-bold shadow-lg shadow-emerald-500/20 transition transform active:scale-95">
                                Submit Spelling <i class="fa-solid fa-paper-plane ml-1"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ================= BADGES & ACHIEVEMENTS SCREEN ================= -->
            <div id="badgeScreen" class="hidden space-y-6">
                <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                    <div>
                        <h2 class="text-2xl font-outfit font-extrabold text-white flex items-center gap-2">
                            <i class="fa-solid fa-trophy text-amber-400"></i>
                            Science Lab Trophies & Badges
                        </h2>
                        <p class="text-xs text-slate-400">Complete spelling challenges across all modes to unlock lab honors!</p>
                    </div>
                    <button onclick="showScreen('menuScreen')" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300 border border-slate-700 transition">
                        <i class="fa-solid fa-house mr-1.5"></i> Menu
                    </button>
                </div>

                <div id="badgeGrid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Badges render here -->
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="relative z-10 py-3 text-center text-xs text-slate-500 glass-panel border-t border-slate-800 mt-auto">
        <p>Science Spell Quest &bull; Interactive Vocabulary Revision Tool</p>
    </footer>

    <!-- Result Feedback Modal -->
    <div id="resultModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
